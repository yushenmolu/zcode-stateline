{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/hooks/on-stop.cmd\" \"${CLAUDE_SESSION_ID}\"",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/hooks/status-event.cmd\" idle \"${CLAUDE_SESSION_ID}\" \"Stop\"",
            "async": false
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/hooks/mark-session.cmd\" \"${CLAUDE_SESSION_ID}\"",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/hooks/inject-context.cmd\" session-start",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/hooks/ensure-docked-statusbar.cmd\"",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/hooks/mark-session.cmd\" \"${CLAUDE_SESSION_ID}\"",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/hooks/inject-context.cmd\" user-prompt-submit \"${CLAUDE_SESSION_ID}\"",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/hooks/status-event.cmd\" generating \"${CLAUDE_SESSION_ID}\" \"UserPromptSubmit\"",
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/hooks/status-event.cmd\" tool \"${CLAUDE_SESSION_ID}\" \"PreToolUse\"",
            "async": false
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/hooks/status-event.cmd\" tool \"${CLAUDE_SESSION_ID}\" \"PermissionRequest\"",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/hooks/status-event.cmd\" generating \"${CLAUDE_SESSION_ID}\" \"PostToolUse\"",
            "async": false
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/hooks/status-event.cmd\" generating \"${CLAUDE_SESSION_ID}\" \"PostToolUseFailure\"",
            "async": false
          }
        ]
      }
    ]
  }
}
